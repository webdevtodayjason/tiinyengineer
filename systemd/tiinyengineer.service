[Unit]
Description=TiinyEngineer operations watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tiinyengineer
Group=tiinyengineer
UMask=0077
WorkingDirectory=/opt/tiinyengineer
Environment=FARM_DATA_DIR=/var/lib/tiinyengineer
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/tiinyengineer.env
ExecStart=/usr/bin/python3 -m tiinyengineer --host 0.0.0.0 --port 8787
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tiinyengineer

[Install]
WantedBy=multi-user.target
